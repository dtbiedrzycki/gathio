<main class="event{{#if editingEnabled}} event--editing{{/if}}{{#if eventData.usersCanAttend}} event--has-rsvp-bar{{/if}}">
{{#if editingEnabled}}
<div class="event__editing-banner">
  {{t "views.event.currentlyediting" }}
</div>
{{/if}}
{{#if eventHasCoverImage}}
  <div class="event-header-image" id="eventImageContainer">
    <img src="/events/{{eventData.image}}" alt="">
  </div>
{{else}}
  <div class="event-header-image" id="genericEventImageContainer" style="background-color: {{coverColor}};"></div>
{{/if}}
<div class="h-event">
<div class="event-title">
  <h2 class="p-name" id="eventName" data-event-id="{{eventData.id}}">{{eventData.name}}</h2>
  <div class="event-when">
    <span class="dt-duration">{{{displayDate}}}</span>
    <time class="dt-start" datetime="{{eventStartISO}}"></time>
    <time class="dt-end" datetime="{{eventEndISO}}"></time>
    <span class="event-when__relative">
      {{#if eventHasBegun}}{{#unless eventHasConcluded}}{{t "views.event.started"}} {{else}}{{t "views.event.ended"}} {{/unless}}{{/if}}{{fromNow}}
    </span>
  </div>
  {{#if editingEnabled}}
    <div class="event-title__actions">
      <button type="button" id="editEvent" class="button button--primary" {{#if eventHasConcluded}}disabled{{/if}} data-event-id="{{eventData.id}}" data-toggle="modal" data-target="#editModal"><i class="fas fa-edit"></i> {{t "views.event.edit" }}</button>
    </div>
  {{/if}}
</div>
{{#if message}}
<div class="alert alert-info mt-3 text-center" role="alert" id="event__message">
    {{message}}
</div>
{{/if}}
<ul class="event-facts">
  <li class="event-fact">
    <span class="event-fact__icon" aria-hidden="true"><i class="fas fa-map-marker-alt"></i></span>
    <div class="event-fact__text">
      {{#if viewerApprovedForLocation}}
        <span class="p-location">{{eventData.location}}</span>
      {{else}}
      <div class="hidden-section">
        <span><i class="fas fa-lock"></i> {{t "views.event.location_hidden" }}</span>
        <span class="small">{{t "views.event.location_hidden_desc" }}</span>
      </div>
      {{/if}}
    </div>
  </li>
  {{#if eventHasHost}}
    <li class="event-fact" id="hosted-by">
      <span class="event-fact__icon" aria-hidden="true"><i class="fas fa-user"></i></span>
      <div class="event-fact__text">{{{t "views.event.hostedby" }}}</div>
    </li>
  {{/if}}
  {{#if eventData.eventGroup}}
    <li class="event-fact" id="event-group">
      <span class="event-fact__icon" aria-hidden="true"><i class="fas fa-calendar-alt"></i></span>
      <div class="event-fact__text">{{{t "views.event.partof" }}}</div>
    </li>
  {{/if}}
  {{#if eventData.url}}
    <li class="event-fact">
      <span class="event-fact__icon" aria-hidden="true"><i class="fas fa-link"></i></span>
      <div class="event-fact__text"><a href="{{eventData.url}}">{{eventData.url}}</a></div>
    </li>
  {{/if}}
</ul>

<div class="quick-actions" role="group" aria-label="Event actions">
  <button type="button" id="shareEvent" class="button button--outline-secondary button--sm" aria-controls="sharePanel" aria-expanded="false" data-share-title="{{eventData.name}}" data-share-url="https://{{domain}}/{{eventData.id}}">
    <i class="fas fa-share-alt"></i> {{t "views.event.sharebutton" }}
  </button>
  <a href="http://www.google.com/calendar/event?action=TEMPLATE&dates={{parsedStart}}%2F{{parsedEnd}}&text={{escapedName}}&location={{calendarLocationParam}}&ctz={{timezone}}" class="button button--outline-secondary button--sm">
    <i class="far fa-calendar-plus"></i> {{t "views.event.addtoGC" }}
  </a>
  <button type="button" id="exportICS" class="button button--outline-secondary button--sm" data-event-id="{{eventData.id}}">
    <i class="fas fa-download"></i> {{t "views.event.ICSexport" }}
  </button>
  {{#if viewerApprovedForLocation}}
    <a target="_blank" rel="noopener noreferrer" href="http://maps.google.com/?q={{parsedLocation}}" class="button button--outline-secondary button--sm">
      <i class="fas fa-map-marked"></i> {{t "views.event.showonGM" }}
    </a>
  {{/if}}
</div>

<div id="sharePanel" class="share-panel" hidden>
  <div class="share-panel__row">
    <span class="share-panel__label">{{ t "views.event.publiclink" }}</span>
    <a class="u-url share-panel__value" href="https://{{domain}}/{{eventData.id}}">https://{{domain}}/{{eventData.id}}</a>
    <button type="button" id="copyEventLink" class="eventInformationAction button button--outline-secondary button--sm" data-clipboard-text="https://{{domain}}/{{eventData.id}}">
      <i class="fas fa-copy"></i> {{t "common.copy" }}
    </button>
  </div>
  {{#if isFederated}}
  <div class="share-panel__row">
    <span class="share-panel__label">{{ t "views.event.fediverselink" }}</span>
    <span class="share-panel__value">@{{eventData.id}}@{{domain}}</span>
    <button type="button" id="copyAPLink" class="eventInformationAction button button--outline-secondary button--sm" data-clipboard-text="@{{eventData.id}}@{{domain}}">
      <i class="fas fa-copy"></i> {{t "common.copy" }}
    </button>
  </div>
  {{/if}}
</div>

{{#if eventHasConcluded}}
<div class="alert alert-warning mb-4" role="alert">
{{t "views.event.concludeddel" }}</div>
{{/if}}
{{#if firstLoad}}
<div class="alert alert-success alert-dismissible fade show" role="alert">
  <button type="button" class="close" data-dismiss="alert" aria-label="Close">
    <span aria-hidden="true">&times;</span>
  </button>
  <p>{{t "views.event.welcome" }}</p>
  <p>{{{t "views.event.attention" }}}</p>
  <p>{{{t "views.event.share" }}}</p>
</div>
{{/if}}
<section class="event-section" id="eventDescription">
  <h3 class="event-section__title">{{t "views.event.about" }}</h3>
  <div class="p-summary">
    {{{parsedDescription}}}
  </div>
</section>

{{#if eventData.usersCanAttend}}
<section class="event-section" id="eventAttendees">
  <h3 class="event-section__title">{{t "views.event.attendees" }}</h3>
    {{#if numberOfAttendees}}
      {{#unless attendeesListHidden}}
        <button type="button" id="attendeesToggle" class="attendees-toggle" aria-label="{{plural "views.event.goingtogglelabel" numberOfAttendees }}" aria-controls="attendeesListWrap" aria-expanded="{{#if editingEnabled}}true{{else}}false{{/if}}">
          <span class="avatar-stack" aria-hidden="true">
            {{#each (avatarStack attendees 5)}}
              <span class="attendee-avatar" style="background-color: {{this.avatarColor}}">{{this.avatarLetter}}</span>
            {{/each}}
          </span>
          <span class="attendees-toggle__count">{{plural "views.event.goingcount" numberOfAttendees }}</span>
          <i class="fas fa-chevron-down attendees-toggle__chevron" aria-hidden="true"></i>
        </button>
      {{/unless}}
    {{/if}}
    {{#if eventData.maxAttendees}}
      {{#if noMoreSpots}}
        <p class="attendees-capacity" id="attendees-alert">{{t "views.event.capacity" }}</p>
      {{else}}
        <p class="attendees-capacity" id="attendees-alert">{{plural "views.event.remaining" spotsRemaining }}</p>
      {{/if}}
    {{/if}}
    {{#if numberOfAttendees}}
      <div id="attendeesListWrap" {{#unless attendeesListHidden}}{{#unless editingEnabled}}hidden{{/unless}}{{/unless}}>
      <ul class="attendeesList">
        {{#each attendees}}
          {{!-- Skip hidden attendees for non-editors --}}
          {{#unless this.isHidden}}
          <li data-attendee-name="{{this.name}}" data-attendee-id="{{this.id}}">
            <span class="attendee-avatar" style="background-color: {{this.avatarColor}}">{{this.avatarLetter}}</span>
            <span class="attendee-info">
              <span class="attendee-info__main">
                <span class="attendee-name">{{this.name}}</span>
                {{#if this.isPending}}
                  <span class="badge badge-warning">{{t "views.event.pending" }}</span>
                {{/if}}
              </span>
              {{#if this.answers}}
                {{> attendeeAnswers this.answers}}
              {{/if}}
            </span>
            {{#if this.canRemove}}
              <span class="attendee-actions">
                {{#if this.canApprove}}
                  <button type="button" class="button button--outline-secondary button--sm approve-attendee" data-event-id="{{../eventData.id}}" data-attendee-id="{{this.id}}" data-edit-token="{{../eventData.editToken}}" title="{{t "views.event.approveattendee" }}"><i class="fas fa-check"></i></button>
                {{/if}}
                {{#if this.canCopyLink}}
                  <button type="button" class="button button--outline-secondary button--sm copy-attendee-link" data-event-id="{{../eventData.id}}" data-removal-password="{{this.removalPassword}}" title="{{t "views.event.copyattendeelink" }}"><i class="fas fa-link"></i></button>
                {{/if}}
                <button type="button" class="button button--outline-secondary button--sm remove-attendee" data-toggle="modal" data-target="#removeAttendeeModal" title="{{t "views.event.removeuser" }}"><i class="fas fa-user-times"></i></button>
              </span>
            {{/if}}
          </li>
          {{/unless}}
          {{!-- Hidden attendees only shown to editors --}}
          {{#if this.isHidden}}
            {{#if this.canRemove}}
            <li data-attendee-name="{{this.name}}" data-attendee-id="{{this.id}}" class="hidden-attendee">
              <span class="attendee-avatar" style="background-color: {{this.avatarColor}}">{{this.avatarLetter}}</span>
              <span class="attendee-info">
                <span class="attendee-info__main">
                  <span class="attendee-name">{{this.name}}</span>
                  <span class="text-muted">{{t "views.event.hidden" }}</span>
                  {{#if this.isPending}}
                    <span class="badge badge-warning">{{t "views.event.pending" }}</span>
                  {{/if}}
                </span>
                {{#if this.answers}}
                  {{> attendeeAnswers this.answers}}
                {{/if}}
              </span>
              <span class="attendee-actions">
                {{#if this.canApprove}}
                  <button type="button" class="button button--outline-secondary button--sm approve-attendee" data-event-id="{{../eventData.id}}" data-attendee-id="{{this.id}}" data-edit-token="{{../eventData.editToken}}" title="{{t "views.event.approveattendee" }}"><i class="fas fa-check"></i></button>
                {{/if}}
                {{#if this.canCopyLink}}
                  <button type="button" class="button button--outline-secondary button--sm copy-attendee-link" data-event-id="{{../eventData.id}}" data-removal-password="{{this.removalPassword}}" title="{{t "views.event.copyattendeelink" }}"><i class="fas fa-link"></i></button>
                {{/if}}
                <button type="button" class="button button--outline-secondary button--sm remove-attendee" data-toggle="modal" data-target="#removeAttendeeModal" title="{{t "views.event.removeuser" }}"><i class="fas fa-user-times"></i></button>
              </span>
            </li>
            {{/if}}
          {{/if}}
        {{/each}}
        {{!-- Hidden attendees count shown to non-editors, but not to pending attendees --}}
        {{#unless editingEnabled}}
          {{#unless viewerRegisteredUnapproved}}
            {{#if numberOfHiddenAttendees}}
              <li class="hidden-attendees-item">
                <span class="text-muted">{{plural "views.event.hiddenattendee" numberOfHiddenAttendees }}</span>
              </li>
            {{/if}}
          {{/unless}}
        {{/unless}}
      </ul>
      </div>
      {{#if attendeesListHidden}}
        <div class="hidden-section mt-3">
          <span><i class="fas fa-lock"></i> {{t "views.event.attendees_hidden" }}</span>
        </div>
      {{/if}}
    {{else}}
      {{#if viewerApprovedForLocation}}
        <p class="text-muted mb-0">{{t "views.event.noattendees" }}</p>
      {{else}}
      <div class="hidden-section">
        <span><i class="fas fa-lock"></i> {{t "views.event.attendees_hidden" }}</span>
      </div>
      {{/if}}
    {{/if}}
</section>

{{#if editingEnabled}}
  {{#if numberOfDeclined}}
    <section class="event-section" id="eventDeclined">
      <h3 class="event-section__title">{{t "views.event.cantattend"}}
        {{t "views.event.numberofcantattend"}}</h3>
        <ul class="attendeesList">
          {{#each declinedAttendees}}
            <li
              data-attendee-name="{{this.name}}"
              data-attendee-id="{{this.id}}"
            >
              <span
                class="attendee-avatar"
                style="background-color: {{this.avatarColor}}"
              >{{this.avatarLetter}}</span>
              <span class="attendee-info">
                <span class="attendee-info__main">
                  <span class="attendee-name">{{this.name}}</span>
                </span>
              </span>
            </li>
          {{/each}}
        </ul>
    </section>
  {{/if}}
{{/if}}

<div class="modal fade" id="attendModal" tabindex="-1" role="dialog" aria-labelledby="attendModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="attendModalLabel">{{t "views.event.addself" }}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form id="attendEventForm" action="/event/{{eventData.id}}/attendee" method="post">
        <input type="hidden" name="fullForm" value="1">
        {{#if editingEnabled}}
        <input type="hidden" name="editToken" value="{{eventData.editToken}}">
        {{/if}}
    <div class="modal-body">
      <div class="form-group">
        <label for="attendeeName">{{t "views.event.attendeename" }}</label>
        <div class="form-group">
          <input type="text" class="form-control" id="attendeeName" name="attendeeName" placeholder="{{t "views.event.attendeenamedesc" }}" data-validation="required length" data-validation-length="1-30">
        </div>
      </div>
      <div class="form-group">
        <label for="attendeeNumber">{{t "views.event.attendeenum" }}</label>
        <div class="form-group">
          <input type="number" class="form-control" id="attendeeNumber" name="attendeeNumber" value="1" data-validation="required number" >
        </div>
      </div>
      <div class="form-group">
        <label for="attendeeEmail">{{t "views.event.attendeeemail" }}</label>
        <p class="form-text small">{{t "views.event.joinemaildesc" }}</p>
        <div class="form-group">
          <input type="email" class="form-control" id="attendeeEmail" name="attendeeEmail" placeholder="{{t "views.event.nospam" }}" data-validation="email" data-validation-optional="true">
        </div>
      </div>
      <div class="form-check">
        <input class="form-check-input" type="checkbox" id="attendeeVisible" name="attendeeVisible" checked>
        <label class="form-check-label" for="attendeeVisible">
          {{t "views.event.attendeevisible" }}
        </label>
        <p class="form-text small">{{t "views.event.attendeevisibledesc" }}</p>
      </div>
      {{#if customQuestions.length}}
        <hr>
        <label class="d-block">{{t "views.event.customquestionsdesc" }}</label>
        {{> customQuestionFields customQuestions}}
      {{/if}}
      <input type="hidden" id="removalPassword" name="removalPassword">
    </div>
      <div class="modal-footer">
        <button type="button" class="button button--secondary" data-dismiss="modal">{{t "common.close" }}</button>
        <button type="submit" class="button button--primary">{{t "views.event.addmyself" }}</button>
      </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="unattendModal" tabindex="-1" role="dialog" aria-labelledby="unattendModalLabel" aria-hidden="true" x-data="{ message: {}, password: new URLSearchParams(window.location.search).get('p') || '' }">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="unattendModalLabel">{{{t "views.event.removemyselfdesc" }}}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form id="unattendEventForm" x-on:submit.prevent="fetch(`/event/attendee/{{eventData.id}}?${new URLSearchParams({ p: password }).toString()}`, { method: 'DELETE' }).then(response => response.ok ? (gathioClearAttendeeInfo('{{eventData.id}}'), window.location.href = '/{{eventData.id}}?m=rsvperased') : response.json().then(data => message = data))">
      <div class="modal-body">
        <p>{{t "views.event.unattendconfirmdesc" }}</p>
        <div x-bind:class="{ 'alert-danger': message?.error, 'alert-success': message?.success }" class="alert" x-text="message?.error || message?.success" x-show="message?.error || message?.success"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="button button--secondary" data-dismiss="modal">{{t "common.close" }}</button>
        <button type="submit" class="button button--primary">{{t "views.event.removemyself" }}</button>
      </div>
      </form>
    </div>
  </div>
</div>

<div class="modal fade" id="declineModal" tabindex="-1" role="dialog" aria-labelledby="declineModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="declineModalLabel">{{t "views.event.declineself" }}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form id="declineEventForm" action="/event/{{eventData.id}}/attendee" method="post">
        {{#if editingEnabled}}
          <input type="hidden" name="editToken" value="{{eventData.editToken}}">
        {{/if}}
        <input type="hidden" name="attendeeStatus" value="declined">
        <div class="modal-body">
          <div class="form-group">
            <label for="declineAttendeeName">{{t "views.event.attendeename" }}</label>
            <div class="form-group">
              <input type="text" class="form-control" id="declineAttendeeName" name="attendeeName" placeholder="{{t 'views.event.attendeenamedesc'}}" data-validation="required length" data-validation-length="1-30">
            </div>
          </div>
          <input type="hidden" id="declineRemovalPassword" name="removalPassword">
        </div>
        <div class="modal-footer">
          <button type="button" class="button button--secondary" data-dismiss="modal">{{t "common.close" }}</button>
          <button type="submit" class="button button--primary">{{t "views.event.removeme" }}</button>
        </div>
      </form>
    </div>
  </div>
</div>
</div>
  {{#if editingEnabled}}
  <div class="modal fade" id="removeAttendeeModal" tabindex="-1" role="dialog" aria-labelledby="removeAttendeeModalLabel" aria-hidden="true" data-event-id="{{eventData.id}}" data-edit-token="{{eventData.editToken}}">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="removeAttendeeModalLabel">{{{t "views.event.removeattendeedesc" }}}</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <p>{{t "views.event.confremoveattendee" }}</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="button button--secondary" data-dismiss="modal">{{t "common.close" }}</button>
          <button type="button" class="button button--danger" id="confirmRemoveAttendee">{{t "views.event.removeAttendee" }}</button>
        </div>
      </div>
    </div>
  </div>
  {{/if}}

<div class="rsvp-bar" id="rsvpBar">
  <div class="rsvp-bar__inner" role="group" aria-label="Attendance controls">
    {{#if editingEnabled}}
      {{#unless noMoreSpots}}
        <button type="button" id="attendEvent" class="button button--primary" data-event-id="{{eventData.id}}"><i class="fas fa-user-plus"></i> {{t "views.event.addattendee" }}</button>
      {{/unless}}
    {{else}}
      {{#if viewerDeclined}}
        <span class="rsvp-bar__status rsvp-bar__status--declined">
          <i class="fas fa-times-circle"></i> {{t "views.event.youdeclined" }}
        </span>
        <button type="button" id="changeRsvp" class="button button--outline-secondary rsvp-bar__change" aria-label="{{t "views.event.changersvplabel" }}" aria-expanded="false" aria-controls="rsvpChangeOptions">{{t "views.event.changersvp" }}</button>
        <div id="rsvpChangeOptions" class="rsvp-bar__options" hidden>
          <form id="reattendEventForm" class="rsvp-bar__form" action="/event/{{eventData.id}}/attendee" method="post">
            <input type="hidden" name="removalPassword" id="reattendRemovalPassword">
            <input type="hidden" name="attendeeStatus" value="attending">
            <button type="submit" id="reattendEvent" class="button button--primary">{{t "views.event.addme" }}</button>
          </form>
          <div class="rsvp-bar__secondary">
            <button type="button" id="deleteMyInfo" class="rsvp-bar__link" data-toggle="modal" data-target="#unattendModal">{{t "views.event.deletemyinfo" }}</button>
          </div>
        </div>
      {{else}}
        {{#if viewerRegistered}}
          <span class="rsvp-bar__status">
            {{#if viewerRegisteredUnapproved}}
              <i class="fas fa-clock"></i> {{t "views.event.pendingapproval" }}
            {{else}}
              <i class="fas fa-check"></i> {{t "views.event.youaregoing" }}
            {{/if}}
          </span>
          <button type="button" id="changeRsvp" class="button button--outline-secondary rsvp-bar__change" aria-label="{{t "views.event.changersvplabel" }}" aria-expanded="false" aria-controls="rsvpChangeOptions">{{t "views.event.changersvp" }}</button>
          <div id="rsvpChangeOptions" class="rsvp-bar__options" hidden>
            <form id="declineExistingForm" class="rsvp-bar__form" action="/event/{{eventData.id}}/attendee" method="post">
              <input type="hidden" name="removalPassword" id="declineExistingRemovalPassword">
              <input type="hidden" name="attendeeStatus" value="declined">
              <button type="submit" id="declineExisting" class="button button--secondary">{{t "views.event.removeme" }}</button>
            </form>
          </div>
        {{else}}
          {{#unless noMoreSpots}}
            <button type="button" id="attendEvent" class="button button--primary" data-event-id="{{eventData.id}}">{{t "views.event.addme" }}</button>
          {{/unless}}
          <button type="button" id="declineEvent" class="button button--secondary" data-event-id="{{eventData.id}}">{{t "views.event.removeme" }}</button>
          <div class="rsvp-bar__secondary">
            <button type="button" id="recoverLink" class="rsvp-bar__link" data-toggle="modal" data-target="#recoverLinkModal">{{t "views.event.recoverlinkbutton" }}</button>
          </div>
        {{/if}}
      {{/if}}
    {{/if}}
  </div>
</div>
{{/if}}


{{#if eventData.usersCanComment}}
<section class="event-section" id="eventComments">
  <h3 class="event-section__title">{{t "views.event.discussion" }}</h3>
    <form id="commentForm" action="/post/comment/{{eventData.id}}/" method="post">
      <label for="commentAuthor">{{t "views.event.commentauthor" }}</label>
      <div class="form-group">
        <input type="text" class="form-control" id="commentAuthor" name="commentAuthor" placeholder="{{t "views.event.commentauthorph" }}" required>
      </div>
      <label for="commentContent">{{t "views.event.comment" }}</label>
      <div class="form-group">
        <div class="d-flex flex-gap">
          <textarea class="form-control" id="commentContent" name="commentContent" style="resize: none;" placeholder="{{t "views.event.commentcontent" }}" maxlength="{{maxCommentLength}}" required></textarea>
          <div class="input-group-append">
            <button type="submit" class="button button--primary" id="postComment">{{t "views.event.postbutton" }} <i class="fas fa-chevron-right"></i></button>
          </div>
        </div>
      </div>
    </form>
    {{#if eventData.comments}}
      <div class="commentsList">
      {{#each eventData.comments}}
        <div class="comment">
          <div class="row commentContainer">
            <div class="col-lg commentText">
              {{#if this.actorId}}
                <p class="mb-0"><a href="{{this.actorId}}"><strong>{{this.author}}</strong></a> <a href="{{this.activityId}}"><small class="commentTimestamp text-muted">{{this.timestamp}}</small></a></p>
              {{else}}
                <p class="mb-0"><strong>{{this.author}}</strong> <small class="commentTimestamp text-muted">{{this.timestamp}}</small></p>
              {{/if}}
              <p>{{this.content}}</p>
              {{#if this.replies}}
                <div class="repliesContainer">
                  {{#each this.replies}}
                    <p class="mb-0"><strong><i class="fas fa-reply text-muted"></i> {{this.author}}</strong> <small class="commentTimestamp text-muted">{{this.timestamp}}</small></p>
                    <p>{{this.content}}</p>
                  {{/each}}
                </div>
              {{/if}}
            </div>
            <div class="col-lg-3 commentMetadata">
              <button type="button" class="comment-action openReplyBox">
                <i class="fas fa-comment"></i> {{t "views.event.reply" }}
              </button>
              {{#if ../editingEnabled}}
                <form class="d-inline" action="/deletecomment/{{../eventData.id}}/{{this._id}}/{{../eventData.editToken}}" method="post">
                  <button type="submit" class="comment-action deleteComment">
                    <i class="fas fa-trash"></i> {{t "views.del" }}
                  </button>
                </form>
              {{/if}}
            </div>
          </div>
          <div class="row replyContainer">
            <div class="col-md">
              <form id="replyForm" action="/post/reply/{{../eventData.id}}/{{this._id}}" method="post">
                <div class="form-group">
                  <input type="text" class="form-control form-control-sm" id="replyAuthor" name="replyAuthor" placeholder="{{t "views.event.attendeename" }}" required>
                </div>
                <div class="form-group">
                  <div class="d-flex flex-gap">
                    <textarea class="form-control form-control-sm" id="replyContent" name="replyContent" style="resize: none;" placeholder="{{t "views.event.replycontent" }}" maxlength="{{maxCommentLength}}" required></textarea>
                    <div class="input-group-append">
                    </div>
                      <button type="submit" class="button button--primary button--sm" id="postReply">{{t "views.event.reply" }} <i class="fas fa-chevron-right"></i></button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      {{/each}}
      </div>
    {{/if}}
</section>
{{/if}}

{{> rsvpConfirmModal }}
{{> recoverLinkModal }}

{{#if editingEnabled}}
{{#unless eventHasConcluded}}
{{> editeventmodal }}
{{/unless}}

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">{{t "views.event.deletetitle" }}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form id="deleteEventForm" action="/deleteevent/{{eventData.id}}/{{eventData.editToken}}" method="post">
      <div class="modal-body">
        <p>{{t "views.event.delconfirm" }}</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="button button--secondary" data-dismiss="modal">{{t "common.close" }}</button>
        <button type="submit" class="button button--danger">{{t "views.event.del" }}</button>
      </div>
      </form>
    </div>
  </div>
</div>

{{/if}}
<script src="/js/modules/event-page.js"></script>

<script>
window.eventData = {{{ json jsonData }}};
// Clears this event's locally-remembered name/removal-password so a
// visitor who deletes their info isn't locked into the old name.
window.gathioClearAttendeeInfo = function(eventID) {
  ['gathioAttendeeNames', 'gathioRemovalPasswords'].forEach(function(key) {
    try {
      const store = JSON.parse(localStorage.getItem(key) || '{}');
      delete store[eventID];
      localStorage.setItem(key, JSON.stringify(store));
    } catch(e) { /* ignore */ }
  });
};
</script>

<script>
  {{#if editingEnabled}}

  $('#removeAttendeeModal').on('show.bs.modal', function (event) {
    var listItem = $(event.relatedTarget).closest('li');
    var attendeeName = listItem.data('attendee-name');
    var attendeeID = listItem.data('attendee-id');
    var modal = $(this);
    modal.find('.modal-title').text('Remove ' + attendeeName + ' from {{eventData.name}}');
    modal.data('attendee-id', attendeeID);
  });

  $('#confirmRemoveAttendee').on('click', function() {
    var modal = $('#removeAttendeeModal');
    var eventId = modal.data('event-id');
    var editToken = modal.data('edit-token');
    var attendeeId = modal.data('attendee-id');
    fetch(`/event/${eventId}/attendee/${attendeeId}?e=${editToken}`, {
      method: 'DELETE'
    }).then(response => {
      if (response.redirected) {
        window.location.href = response.url;
      } else if (response.ok) {
        window.location.reload();
      } else {
        alert('Failed to remove attendee');
      }
    }).catch(err => {
      console.error('Error removing attendee:', err);
      alert('Failed to remove attendee');
    });
  });
  {{/if}}
  $(".commentTimestamp").html(function(){
    parsedDate = moment($(this).html()).fromNow();
    return parsedDate;
  });
  $(".openReplyBox").click(function(){
//    let replyID = $(this).attr("data-id");
    $(this).closest(".comment").find(".replyContainer").slideToggle();
  });
  $(document).ready(function() {
    // Save the editing token from the URL, if it is valid
    const eventID = $('#eventName').attr('data-event-id');
    const url = new URL(window.location.href);
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('e')) {
      $.ajax({
        type: "POST",
        url: `/verifytoken/event/${eventID}`,
        data: { editToken: urlParams.get('e') },
        success: function(response, status, xhr) {
          if (xhr.status === 200) {
            addStoredToken(eventID, urlParams.get('e'));
          }
        },
        error: function(response, status, xhr) {
          // The editing token is wrong - remove it
          removeStoredToken(eventID);
          // Remove the token from the URL
          url.searchParams.delete('e');
          window.location = url.href;
        }
      });
    } else if (getStoredToken(eventID)) {
      const editToken = getStoredToken(eventID);
      $.ajax({
        type: "POST",
        url: `/verifytoken/event/${eventID}`,
        data: { editToken },
        success: function(response, status, xhr) {
          if (xhr.status === 200) {
            // Redirect to the same URL with the editing token in the URL
            // We reload the page to force the server to load a page with
            // the editing form accessible.
            window.location.search = `?e=${editToken}`;
          }
        },
        error: function(response, status, xhr) {
          // The editing token is wrong - remove it
          removeStoredToken(eventID);
        }
      });
    }

    if (urlParams.has('show_edit')) {
      $('#editModal').modal('show');
      url.searchParams.delete('show_edit');
      history.replaceState(history.state, '', url.href);
    }

    // Reusable dismissable confirmation modal (views/partials/rsvpConfirmModal.handlebars),
    // shown after any RSVP state change via the ?m= query param. showSecretLink
    // is only needed when the attendee didn't give an email - with an email on
    // file they already have (or will get) the link there, so showing it here
    // too would just be a redundant secret to hold onto.
    function showRsvpConfirmModal({ title, description, showSecretLink }) {
      $('#rsvpConfirmModalLabel').text(title);
      $('#rsvpConfirmModalDescription').html(description);
      if (showSecretLink) {
        const secretLink = window.location.origin + window.location.pathname + '?p=' + urlParams.get('p');
        $('#rsvpSecretLink').val(secretLink);
        $('#rsvpConfirmModalSecretLink').show();
        new ClipboardJS('#copyRsvpLink', {
          target: function() {
            return document.getElementById('rsvpSecretLink');
          }
        });
        $('#copyRsvpLink').on('click', function() {
          $(this).html('<i class="fas fa-check"></i> {{t "common.copied" }}');
          setTimeout(() => {
            $(this).html('<i class="fas fa-copy"></i> {{t "common.copy" }}');
          }, 3000);
        });
      } else {
        $('#rsvpConfirmModalSecretLink').hide();
      }
      $('#rsvpConfirmModal').modal('show');
    }

    // Whether the attendee gave an email decides showSecretLink below - it's
    // set server-side (src/routes/event.ts) since only the server knows what
    // was actually saved to the attendee record.
    const noEmailOnFile = urlParams.get('noemail') === '1';
    const rsvpConfirmMessages = {
      rsvpgoing: {
        title: "{{{t 'views.event.rsvpgoing' }}}",
        description: "{{{t 'views.event.rsvpgoingdesc' }}}",
        showSecretLink: noEmailOnFile,
      },
      rsvpdeclined: {
        title: "{{{t 'views.event.rsvpdeclinedtitle' }}}",
        description: "{{{t 'views.event.rsvpdeclineddesc' }}}",
        showSecretLink: noEmailOnFile,
      },
      rsvperased: {
        title: "{{{t 'views.event.rsvperasedtitle' }}}",
        description: "{{{t 'views.event.rsvperaseddesc' }}}",
        showSecretLink: false,
      },
      rsvppending: {
        title: "{{{t 'views.event.rsvppending' }}}",
        description: "{{{t 'views.event.rsvppendingdesc' }}}",
        showSecretLink: noEmailOnFile,
      },
    };

    if (urlParams.has('m')) {
      const messageType = urlParams.get('m');
      if (rsvpConfirmMessages[messageType]) {
        showRsvpConfirmModal(rsvpConfirmMessages[messageType]);
      }
      url.searchParams.delete('m');
      url.searchParams.delete('noemail');
      history.replaceState(history.state, '', url.href);
    }

    // Reset the recover-link form each time it's reopened, so a prior
    // success/error message doesn't linger on the next attempt.
    $('#recoverLinkModal').on('hidden.bs.modal', function() {
      $('#recoverLinkForm')[0].reset();
      $('#recoverLinkModalDescription').show();
      $('#recoverLinkMessage').hide().removeClass('alert-danger').addClass('alert-success');
      $('#recoverLinkForm .form-group').show();
      $('#recoverLinkForm button[type="submit"]').show();
    });

    // POSTs JSON and resolves with { data } like the axios calls this
    // replaced; rejects on a non-2xx status
    function postJSON(url, body) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      }).then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json().then((data) => ({ data }));
      });
    }

    // Recover-your-link form (views/partials/recoverLinkModal.handlebars):
    // always returns the same generic message whether or not the email
    // matches an attendee, so this can't be used to check who's RSVPed.
    $('#recoverLinkForm').on('submit', function(e) {
      e.preventDefault();
      const form = $(this);
      const email = $('#recoverLinkEmail').val();
      postJSON('/event/{{eventData.id}}/resend-link', { email })
        .then((response) => {
          $('#recoverLinkModalDescription').hide();
          $('#recoverLinkMessage').text(response.data.message).show();
          form.find('.form-group').hide();
          form.find('button[type="submit"]').hide();
        })
        .catch(() => {
          $('#recoverLinkMessage')
            .removeClass('alert-success').addClass('alert-danger')
            .text('{{t "views.event.recoverlinkerror" }}')
            .show();
        });
    });

    // From https://davidwalsh.name/javascript-download
    function downloadFile(data, fileName, type="text/calendar") {
      // Create an invisible A element
      const a = document.createElement("a");
      a.style.display = "none";
      document.body.appendChild(a);

      // Set the HREF to a Blob representation of the data to be downloaded
      a.href = window.URL.createObjectURL(
        new Blob([data], { type })
      );

      // Use download attribute to set set desired file name
      a.setAttribute("download", fileName);

      // Trigger the download by simulating click
      a.click();

      // Cleanup
      window.URL.revokeObjectURL(a.href);
      document.body.removeChild(a);
    }

    new ClipboardJS('#copyEventLink');
    $("#exportICS").click(function(){
      let eventID = $(this).attr('data-event-id');
      $.get('/export/event/' + eventID, function(response) {
        downloadFile(response, eventID + '.ics');
      })
    })
    $("#copyEventLink").click(function(){
      $(this).html('<i class="fas fa-copy"></i> {{t "common.copied" }}');
      setTimeout(function(){ $("#copyEventLink").html('<i class="fas fa-copy"></i> {{t "common.copy" }}');}, 5000);
    })
    new ClipboardJS('#copyAPLink');
    $("#copyAPLink").click(function(){
      $(this).html('<i class="fas fa-copy"></i> {{t "common.copied" }}');
      setTimeout(function(){ $("#copyAPLink").html('<i class="fas fa-copy"></i> {{t "common.copy" }}');}, 5000);
    })
    $('#attendEvent').on('click', function() {
      const modal = $('#attendModal');
      const eventID = $(this).attr('data-event-id');
      postJSON(`/attendee/provision?eventID=${encodeURIComponent(eventID)}`, {})
        .then((response) => {
          modal.find('#removalPassword').val(response.data.removalPassword);
          // Persist removal password locally for auto ?p injection
          try {
            const rpStore = JSON.parse(localStorage.getItem('gathioRemovalPasswords') || '{}');
            rpStore[eventID] = response.data.removalPassword;
            localStorage.setItem('gathioRemovalPasswords', JSON.stringify(rpStore));
          } catch(e) { /* ignore persistence errors */ }
          // If there is a limit on the number of attendees, the provisioned endpoint will return freeSpots;
          // otherwise, freeSpots will be undefined.
          if (response.data.freeSpots !== undefined) {
            modal.find('#attendeeNumber')
              .attr('data-validation-allowing', `range[1;${response.data.freeSpots}]`)
              .attr('data-validation-error-msg', `{{t "views.event.numlimit" }}`);
          }
          modal.modal();
        })
        .catch((error) => {
          console.error(error);
          return false;
        });
    });
    $('#declineEvent').on('click', function() {
      const modal = $('#declineModal');
      const eventID = $(this).attr('data-event-id');
      postJSON(`/attendee/provision?eventID=${encodeURIComponent(eventID)}`, {})
        .then((response) => {
          modal.find('#declineRemovalPassword').val(response.data.removalPassword);
          try {
            const rpStore = JSON.parse(localStorage.getItem('gathioRemovalPasswords') || '{}');
            rpStore[eventID] = response.data.removalPassword;
            localStorage.setItem('gathioRemovalPasswords', JSON.stringify(rpStore));
          } catch(e) { /* ignore persistence errors */ }
          modal.modal();
        })
        .catch((error) => {
          console.error(error);
          alert('Failed to open the RSVP form');
          return false;
        });
    });

    // Toggling attending<->declined is a real form submit (not a JS
    // fetch+reload) so the browser handles the navigation natively -
    // JS-triggered location.reload()/replace() proved unreliable to
    // detect in automated-browser environments. The removalPassword
    // lives in the ?p= query param, not in the DOM, so it's copied into
    // each form's hidden field synchronously on page load.
    (function populateToggleFormPasswords(){
      const removalPassword = new URLSearchParams(window.location.search).get('p');
      if (!removalPassword) return;
      $('#reattendRemovalPassword, #declineExistingRemovalPassword').val(removalPassword);
    })();

    $('#deleteEvent').on('click', function() {
        $('#editModal').modal('hide');
    });

    // Persist the attendee's name (from RSVP/decline) across name fields on
    // this page so the same visitor can't post comments/replies under a
    // different name. Mirrors the gathioRemovalPasswords pattern above.
    (function persistAttendeeName(){
      const eventID = $('#eventName').attr('data-event-id');
      if (!eventID) return;

      function storeName(name) {
        if (!name) return;
        try {
          const nameStore = JSON.parse(localStorage.getItem('gathioAttendeeNames') || '{}');
          nameStore[eventID] = name;
          localStorage.setItem('gathioAttendeeNames', JSON.stringify(nameStore));
        } catch(e) { /* ignore persistence errors */ }
      }

      $('#attendEventForm, #declineEventForm').on('submit', function() {
        storeName($(this).find('input[name="attendeeName"]').val());
      });

      try {
        const nameStore = JSON.parse(localStorage.getItem('gathioAttendeeNames') || '{}');
        const storedName = nameStore[eventID];
        if (storedName) {
          $('input[name="attendeeName"], input[name="commentAuthor"], input[name="replyAuthor"]')
            .val(storedName)
            .attr('readonly', true);
        }
      } catch(e) { /* ignore */ }
    })();

    // Auto-append ?p if stored and missing (not in editing mode)
    (function autoAppendRemovalPassword(){
      try {
        const eventID = $('#eventName').attr('data-event-id');
        if (!eventID) return;
        const url = new URL(window.location.href);
        if (url.searchParams.get('e')) return; // host editing overrides
        if (url.searchParams.get('p')) return; // already present
        const rpStore = JSON.parse(localStorage.getItem('gathioRemovalPasswords') || '{}');
        const rp = rpStore[eventID];
        if (rp) {
          url.searchParams.set('p', rp);
          window.location.replace(url.href);
        }
      } catch(e) { /* ignore */ }
    })();

    // Approve attendee handler
    $('.approve-attendee').on('click', function() {
      const eventId = $(this).data('event-id');
      const attendeeId = $(this).data('attendee-id');
      const editToken = $(this).data('edit-token');
      fetch(`/event/${eventId}/attendee/${attendeeId}?e=${editToken}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ approved: true })
      }).then(response => {
        if (response.redirected) {
          window.location.href = response.url;
        } else if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to approve attendee');
        }
      }).catch(err => {
        console.error('Error approving attendee:', err);
        alert('Failed to approve attendee');
      });
    });

    // Copy attendee link handler (for host to share with attendee)
    $('.copy-attendee-link').on('click', function() {
      const eventId = $(this).data('event-id');
      const removalPassword = $(this).data('removal-password');
      const link = window.location.origin + '/' + eventId + '?p=' + encodeURIComponent(removalPassword);
      navigator.clipboard.writeText(link).then(() => {
        const $btn = $(this);
        const originalHtml = $btn.html();
        $btn.html('<i class="fas fa-check"></i>');
        setTimeout(() => {
          $btn.html(originalHtml);
        }, 2000);
      }).catch(err => {
        console.error('Failed to copy link:', err);
        prompt('Copy this link:', link);
      });
    });
  });

  </script>
</main>
